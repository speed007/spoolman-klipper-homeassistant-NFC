# Example ESPHome secrets for the SpoolmanNFC reader.
#
# Either copy this file to `secrets.yaml` (if this is your standalone ESPHome
# config directory), or copy the keys below into the `secrets.yaml` you already
# use. `secrets.yaml` is git-ignored — never commit real credentials.
#
#   cp secrets.yaml.example secrets.yaml   # then edit it

wifi_ssid: "your-2.4GHz-ssid"
wifi_password: "your-wifi-password"

# 32-byte base64 key for the ESPHome API (encryption). ESPHome generates one if
# you run its wizard, or use any 44-character base64 string.
spoolmannfc_api_key: "REPLACE_WITH_BASE64_32_BYTE_KEY="

# Password for the fallback hotspot the reader raises if WiFi fails.
ap_password: "fallback-hotspot-password"

# Full URL the reader POSTs a scanned tag to: your Home Assistant base URL plus
# the webhook id used by the automation in ha_nfc_spool.yaml. Keep the id long
# and random — anyone who knows it can post tags to your instance.
spool_nfc_webhook: "http://homeassistant.local:8123/api/webhook/REPLACE_WITH_A_LONG_RANDOM_ID"
